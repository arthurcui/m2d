{
  "name": "m2d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present build:types && pnpm -r typecheck && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present build:types && vitest run",
    "test:integration": "pnpm -r --if-present build:types && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "eval:company-search": "pnpm --filter @m2d/api... build && node --env-file-if-exists=.env scripts/evaluate-company-search.mjs",
    "fixture:portfolio": "pnpm --filter @m2d/ingestion... build && node scripts/generate-portfolio-fixture.mjs",
    "db:generate": "pnpm --filter @m2d/db generate",
    "db:migrate": "pnpm --filter @m2d/db migrate",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "docs:erd": "pnpm --filter @m2d/db... --if-present build:types && node packages/db/dist/erd.js",
    "docs:erd:check": "pnpm --filter @m2d/db... --if-present build:types && node packages/db/dist/erd.js --check",
    "eval:research-sources": "pnpm --filter @m2d/api... build && node --env-file-if-exists=.env scripts/evaluate-research-sources.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "fflate": "0.8.3",
    "pg-boss": "12.38.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "write-excel-file": "4.1.1"
  }
}

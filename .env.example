# Offline mode needs no key. Set LLM_PROVIDER=openai and LLM_MODEL=gpt-5.4-mini-2026-03-17 for AI workbook parsing.
WEB_PORT=3000
POSTGRES_DB=m2d
POSTGRES_USER=m2d
POSTGRES_PASSWORD=m2d-local-only
DATABASE_URL=postgresql://m2d:m2d-local-only@localhost:5432/m2d
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
APP_TIMEZONE=America/Vancouver
MARKET_TIMEZONE=America/New_York
BASE_CURRENCY=USD
LLM_PROVIDER=fixture
LLM_MODEL=fixture-v1
# Backend-only OpenAI credential. Never supply to web or Docker build arguments.
OPENAI_API_KEY=
MARKET_PROVIDER=fixture

# M2 execution ceilings and optional operator-maintained USD price estimates.
ANALYSIS_MODE_DEFAULT=standard
LLM_DAILY_BUDGET_USD=
LLM_INPUT_USD_PER_MILLION=
LLM_MAX_INPUT_CHARACTERS=80000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RUN_COST_USD=
LLM_MAX_STEPS=16
LLM_MAX_TOOL_CALLS=24
LLM_OUTPUT_USD_PER_MILLION=
LLM_PRICE_VERSION=
LLM_REQUEST_TIMEOUT_MS=60000
LLM_RUN_TIMEOUT_MS=300000

# Market data is independent of LLM inference. No key is needed in fixture mode.
# Optional: MARKET_PROVIDER=twelvedata with a licensed data plan.
TWELVE_DATA_API_KEY=
# Free end-of-day stocks/options: MARKET_PROVIDER=massive
MASSIVE_API_KEY=
# Leave blank for unknown delay; set only to your plan's documented delay.
MARKET_DELAY_MINUTES=
BASE_CURRENCY=USD
